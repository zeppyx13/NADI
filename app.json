{
  "expo": {
    "name": "NADI",
    "slug": "NADI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nadi-icon.png",
    "scheme": "nadi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.NADI"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/nadi-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.NADI"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nadi-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/nadi-splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-image",
      "expo-font",
      "expo-status-bar",
      "expo-localization",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "NADI memakai kamera untuk memindai kode QR check-in di destinasi dan UMKM mitra."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a46cf848-7b0b-4726-9bc1-3e6c53155053"
      }
    }
  }
}
